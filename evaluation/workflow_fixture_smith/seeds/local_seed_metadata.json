{
  "schema": "workflow_fixture_smith_seed_pack.v1",
  "seeds": [
    {
      "id": "policy-plan-tradeoff",
      "title": "Policy plan tradeoff candidate",
      "source_kind": "checked_in_seed_metadata",
      "prompt": "Review a local workflow policy plan and propose one bounded repository change plus one report artifact. Stay within the named files and use only offline fixture metadata.",
      "tags": [
        "policy-plan",
        "tradeoff",
        "bounded-edit"
      ],
      "tool_chain_shape": [
        "read_file",
        "search",
        "write_file",
        "write_artifact",
        "run_command"
      ],
      "expected_artifacts": [
        "artifacts/policy_tradeoff_review.md"
      ],
      "verifier_requirements": {
        "deterministic": true,
        "required_reports": [
          "artifacts/policy_tradeoff_review.md"
        ],
        "expected_file_touches": [
          "src/workflow_policy.py"
        ],
        "deterministic_checks": [
          "python -m pytest tests/test_workflow_policy.py"
        ]
      },
      "safety_gates": {
        "network": false,
        "live_github_import": false,
        "unbounded_scope_allowed": false,
        "allowed_mutations": [
          "repo",
          "artifact"
        ],
        "max_files_changed": 2
      },
      "variants": [
        {
          "id": "impact-vs-full-gate",
          "title": "Impact map versus full gate decision",
          "prompt_delta": "Choose between a narrow test-impact gate and a full test run based on local metadata, and document the tradeoff in the expected artifact.",
          "tags": [
            "test-impact",
            "gate-selection"
          ],
          "tool_chain_shape": [
            "safety_gate"
          ],
          "expected_artifacts": [
            "artifacts/test_gate_decision.json"
          ],
          "required_reports": [
            "artifacts/test_gate_decision.json"
          ],
          "deterministic_checks": [
            "python -m pytest tests/test_workflow_policy.py tests/test_test_impact_map.py"
          ],
          "diversity_reason": "combines policy planning, artifact reporting, and explicit gate-selection tradeoffs"
        }
      ]
    },
    {
